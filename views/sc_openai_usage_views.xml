<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- OpenAI Usage Snapshot Tree View -->
        <record id="sc_openai_usage_snapshot_view_tree" model="ir.ui.view">
            <field name="name">sc.openai.usage.snapshot.tree</field>
            <field name="model">sc.openai.usage.snapshot</field>
            <field name="arch" type="xml">
                <list string="OpenAI Usage Statistics" create="false" delete="false">
                    <field name="date"/>
                    <field name="prompt_tokens"/>
                    <field name="completion_tokens"/>
                    <field name="total_tokens"/>
                    <field name="estimated_cost" widget="monetary" options="{'currency_field': false}"/>
                    <field name="fetch_timestamp"/>
                </list>
            </field>
        </record>

        <!-- OpenAI Usage Snapshot Form View -->
        <record id="sc_openai_usage_snapshot_view_form" model="ir.ui.view">
            <field name="name">sc.openai.usage.snapshot.form</field>
            <field name="model">sc.openai.usage.snapshot</field>
            <field name="arch" type="xml">
                <form string="OpenAI Usage Snapshot" create="false" delete="false">
                    <header>
                        <button name="action_refetch_data" type="object" string="Refetch Data" 
                                class="btn-secondary"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="fetch_timestamp"/>
                            </group>
                            <group>
                                <field name="prompt_tokens"/>
                                <field name="completion_tokens"/>
                                <field name="total_tokens"/>
                                <field name="estimated_cost" widget="monetary" options="{'currency_field': false}"/>
                            </group>
                        </group>
                        
                        <group string="Raw API Response" invisible="not api_response_raw">
                            <field name="api_response_raw" nolabel="1" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- OpenAI Usage Snapshot Search View -->
        <record id="sc_openai_usage_snapshot_view_search" model="ir.ui.view">
            <field name="name">sc.openai.usage.snapshot.search</field>
            <field name="model">sc.openai.usage.snapshot</field>
            <field name="arch" type="xml">
                <search>
                    <field name="date"/>
                    <filter name="last_30_days" string="Last 30 Days" 
                            domain="[('date', '>=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                    <filter name="last_90_days" string="Last 90 Days"
                            domain="[('date', '>=', (context_today() - datetime.timedelta(days=90)).strftime('%Y-%m-%d'))]"/>
                    <filter name="this_month" string="This Month"
                            domain="[('date', '>=', context_today().replace(day=1))]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_month" string="Month" context="{'group_by': 'date:month'}"/>
                        <filter name="group_by_week" string="Week" context="{'group_by': 'date:week'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- OpenAI Usage Dashboard -->
        <record id="sc_openai_usage_dashboard_view" model="ir.ui.view">
            <field name="name">sc.openai.usage.dashboard</field>
            <field name="model">sc.openai.usage.snapshot</field>
            <field name="arch" type="xml">
                <form string="OpenAI Usage Dashboard" create="false" edit="false" delete="false">
                    <header>
                        <button name="fetch_usage_data_from_api" type="object" string="Fetch Latest Data" 
                                class="btn-primary"/>
                    </header>
                    <sheet>
                        <div class="row">
                            <div class="col-lg-12">
                                <h1>OpenAI API Usage Dashboard</h1>
                                <p class="text-muted">Monitor your OpenAI API token consumption and estimated costs</p>
                            </div>
                        </div>
                        
                        <!-- Summary Cards -->
                        <div class="row mt32">
                            <div class="col-lg-3">
                                <div class="card">
                                    <div class="card-body text-center">
                                        <h3 class="text-primary">Last 30 Days</h3>
                                        <p class="text-muted">Token Usage Summary</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Graph Placeholder -->
                        <div class="row mt32">
                            <div class="col-lg-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h4>Token Usage Over Time (Last 30 Days)</h4>
                                    </div>
                                    <div class="card-body">
                                        <p class="text-muted">
                                            Graph visualization will be implemented in a future version.
                                            For now, use the detailed view below to analyze usage patterns.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Recent Usage Records -->
                        <div class="row mt32">
                            <div class="col-lg-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h4>Recent Usage Records</h4>
                                    </div>
                                    <div class="card-body">
                                        <!-- Embedded list view would go here in a full implementation -->
                                        <p>
                                            <a href="/web#action=action_sc_openai_usage_snapshot&amp;model=sc.openai.usage.snapshot&amp;view_type=list" 
                                               class="btn btn-link">View All Usage Records →</a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- OpenAI Usage Snapshot Action -->
        <record id="action_sc_openai_usage_snapshot" model="ir.actions.act_window">
            <field name="name">OpenAI Usage Statistics</field>
            <field name="res_model">sc.openai.usage.snapshot</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_last_30_days': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No usage data available yet!
                </p>
                <p>
                    OpenAI usage statistics are automatically collected daily.
                    Use the "Fetch Latest Data" button to manually retrieve current usage information.
                </p>
            </field>
        </record>

        <!-- OpenAI Usage Dashboard Action -->
        <record id="action_sc_openai_usage_dashboard" model="ir.actions.act_window">
            <field name="name">OpenAI Usage Dashboard</field>
            <field name="res_model">sc.openai.usage.snapshot</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="sc_openai_usage_dashboard_view"/>
            <field name="target">current</field>
        </record>
    </data>
</odoo>
