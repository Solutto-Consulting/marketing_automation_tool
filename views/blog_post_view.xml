<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Blog Post List View to add Translation Status Column -->
    <record id="blog_post_view_list_inherit" model="ir.ui.view">
        <field name="name">blog.post.list.inherit.marketing.automation</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.view_blog_post_list"/>
        <field name="arch" type="xml">
            <!-- Add translation status column after state -->
            <xpath expr="//field[@name='website_published']" position="after">
                <field name="translation_status" widget="badge" 
                       decoration-info="translation_status == 'not_translated'"
                       decoration-warning="translation_status == 'in_progress'"
                       decoration-success="translation_status == 'completed'"
                       decoration-danger="translation_status == 'failed'"/>
            </xpath>
        </field>
    </record>

    <!-- Server Action for "Send to Translate" -->
    <record id="action_blog_post_send_to_translate" model="ir.actions.server">
        <field name="name">Send to Translate</field>
        <field name="model_id" ref="website_blog.model_blog_post"/>
        <field name="binding_model_id" ref="website_blog.model_blog_post"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('website.group_website_designer'))]"/>
        <field name="code">
# Check if any records are in progress
posts_in_progress = records.filtered(lambda p: p.translation_status == 'in_progress')
if posts_in_progress:
    post_names = ', '.join(posts_in_progress.mapped('name'))
    raise UserError(_("The following articles are already being translated:\n%s\n\nPlease wait for the translation process to complete.") % post_names)

# Open the translation wizard
action = {
    'type': 'ir.actions.act_window',
    'name': _('Send to Translate'),
    'res_model': 'blog.post.translation.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {
        'default_post_ids': [(6, 0, records.ids)],
        'active_ids': records.ids,
        'active_model': 'blog.post',
    }
}
        </field>
    </record>

    <!-- Inherit Blog Post Form View to show Translation Status -->
    <record id="blog_post_view_form_inherit" model="ir.ui.view">
        <field name="name">blog.post.form.inherit.marketing.automation</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.view_blog_post_form"/>
        <field name="arch" type="xml">
            <!-- Add translation status field in header -->
            <xpath expr="//sheet//div[@class='oe_button_box']" position="inside">
                <div class="oe_stat_button" attrs="{'invisible': [('translation_status', '=', 'not_translated')]}">
                    <field name="translation_status" widget="badge" 
                           decoration-info="translation_status == 'not_translated'"
                           decoration-warning="translation_status == 'in_progress'"
                           decoration-success="translation_status == 'completed'"
                           decoration-danger="translation_status == 'failed'"/>
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Translation</span>
                    </div>
                </div>
            </xpath>
            
            <!-- Add send to translate button in header -->
            <xpath expr="//header" position="inside">
                <button name="action_send_to_translate" 
                        string="Send to Translate" 
                        type="object" 
                        class="btn-primary"
                        groups="website.group_website_designer"
                        attrs="{'invisible': [('translation_status', '=', 'in_progress')]}"/>
            </xpath>
        </field>
    </record>
    
    <!-- Blog Post Search View - Add Translation Status Filter -->
    <record id="blog_post_view_search_inherit" model="ir.ui.view">
        <field name="name">blog.post.search.inherit.marketing.automation</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.view_blog_post_search"/>
        <field name="arch" type="xml">
            <!-- Add translation status filters -->
            <xpath expr="//filter[@name='inactive']" position="before">
                <separator/>
                <filter string="Not Translated" name="not_translated" 
                        domain="[('translation_status', '=', 'not_translated')]"/>
                <filter string="In Translation" name="in_progress" 
                        domain="[('translation_status', '=', 'in_progress')]"/>
                <filter string="Translated" name="translated" 
                        domain="[('translation_status', '=', 'completed')]"/>
                <filter string="Translation Failed" name="failed" 
                        domain="[('translation_status', '=', 'failed')]"/>
            </xpath>
            
            <!-- Add group by translation status -->
            <xpath expr="//group" position="inside">
                <filter string="Translation Status" name="group_translation_status" 
                        domain="[]" context="{'group_by': 'translation_status'}"/>
            </xpath>
        </field>
    </record>
</odoo>
