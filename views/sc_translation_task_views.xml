<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Translation Task List View (using <list> instead of <tree>) -->
    <record id="sc_translation_task_view_list" model="ir.ui.view">
        <field name="name">sc.translation.task.view.list</field>
        <field name="model">sc.translation.task</field>
        <field name="arch" type="xml">
            <list string="Translation Tasks" 
                  decoration-info="state in ('draft', 'in_progress')"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="blog_post_title"/>
                <field name="target_language_name"/>
                <field name="state" widget="badge"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Translation Task Form View -->
    <record id="sc_translation_task_view_form" model="ir.ui.view">
        <field name="name">sc.translation.task.view.form</field>
        <field name="model">sc.translation.task</field>
        <field name="arch" type="xml">
            <form string="Translation Task">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                    <button name="action_process_translation" 
                            string="Process Translation" 
                            type="object" 
                            class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="This will translate the blog post. Continue?"/>
                    <button name="action_verify_translations" 
                            string="Verify Translations" 
                            type="object" 
                            class="btn-info"
                            invisible="state == 'draft'"/>
                    <button name="action_validate_html_structure" 
                            string="Validate HTML Structure" 
                            type="object" 
                            class="btn-info"
                            invisible="state == 'draft'"
                            help="Check if HTML structure is consistent between original and translated content"/>
                    <button name="action_restore_original_content" 
                            string="Restore Original Content" 
                            type="object" 
                            class="btn-warning"
                            confirm="This will restore the original English content. Any previous translations may be lost. Continue?"/>
                    <button name="action_reset_to_draft" 
                            string="Reset to Draft" 
                            type="object" 
                            class="btn-warning"
                            invisible="state != 'error'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="blog_post_id" readonly="state != 'draft'"/>
                            <field name="target_lang_id" readonly="state != 'draft'"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="write_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Instructions" name="instructions">
                            <field name="system_instructions" 
                                   placeholder="Optional instructions to guide the AI's tone and style..."
                                   readonly="state not in ('draft', 'error')"/>
                        </page>
                        <page string="Error Details" name="error_details" invisible="state != 'error'">
                            <field name="error_message" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Translation Task Kanban View -->
    <record id="sc_translation_task_view_kanban" model="ir.ui.view">
        <field name="name">sc.translation.task.view.kanban</field>
        <field name="model">sc.translation.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <field name="blog_post_title"/>
                <field name="target_language_name"/>
                <field name="create_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <i class="fa fa-file-text-o"/> <field name="blog_post_title"/>
                                    </div>
                                    <div class="o_kanban_record_subtitle">
                                        <i class="fa fa-language"/> <field name="target_language_name"/>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <span class="o_kanban_record_date">
                                                <field name="create_date"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Translation Task Search View -->
    <record id="sc_translation_task_view_search" model="ir.ui.view">
        <field name="name">sc.translation.task.view.search</field>
        <field name="model">sc.translation.task</field>
        <field name="arch" type="xml">
            <search string="Translation Tasks">
                <field name="name"/>
                <field name="blog_post_id"/>
                <field name="target_lang_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Error" name="error" domain="[('state', '=', 'error')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Blog Post" name="group_by_blog_post" context="{'group_by': 'blog_post_id'}"/>
                    <filter string="Target Language" name="group_by_target_lang" context="{'group_by': 'target_lang_id'}"/>
                    <filter string="Creation Date" name="group_by_create_date" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Translation Task Action -->
    <record id="sc_translation_task_action" model="ir.actions.act_window">
        <field name="name">Translation Tasks</field>
        <field name="res_model">sc.translation.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first AI translation task!
            </p>
            <p>
                Translation tasks are automatically created when you select blog posts 
                and use the "Translate with AI" action. You can monitor their progress 
                and manage errors from this view.
            </p>
        </field>
    </record>
</odoo>
