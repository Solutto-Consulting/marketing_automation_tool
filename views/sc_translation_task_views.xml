<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions for Translation Tasks -->
    <record id="action_sc_translation_task" model="ir.actions.act_window">
        <field name="name">Translation Tasks</field>
        <field name="res_model">sc.translation.task</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{
            'search_default_my_tasks': 1,
            'search_default_active_tasks': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first translation task!
            </p>
            <p>
                Use AI-powered translation to automatically translate your blog posts 
                into multiple languages with custom instructions and full tracking.
            </p>
        </field>
    </record>

    <!-- List View for Translation Tasks (Odoo 18.0 compliant) -->
    <record id="view_sc_translation_task_list" model="ir.ui.view">
        <field name="name">sc.translation.task.list</field>
        <field name="model">sc.translation.task</field>
        <field name="arch" type="xml">
            <list string="Translation Tasks" default_order="create_date desc" multi_edit="1">
                <field name="name" readonly="1"/>
                <field name="blog_post_id"/>
                <field name="target_lang_id"/>
                <field name="state" widget="badge" 
                       decoration-info="state in ('draft', 'in_progress')"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"/>
                <field name="create_date"/>
                <field name="processed_date"/>
                <field name="processing_duration" widget="float_time"/>
                <field name="create_uid"/>
                <field name="company_id" column_invisible="not context.get('show_company')" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Form View for Translation Tasks with Chatter -->
    <record id="view_sc_translation_task_form" model="ir.ui.view">
        <field name="name">sc.translation.task.form</field>
        <field name="model">sc.translation.task</field>
        <field name="arch" type="xml">
            <form string="Translation Task">
                <header>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" 
                            invisible="state != 'error'" class="btn-secondary"
                            confirm="Are you sure you want to reset this task to draft? This will allow it to be processed again."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_start_processing" type="object" 
                                class="oe_stat_button" icon="fa-play"
                                invisible="state != 'draft'"
                                confirm="Start processing this translation task?">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Start</span>
                                <span class="o_stat_text">Processing</span>
                            </div>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="blog_post_id" readonly="state != 'draft'" 
                                   options="{'no_create': True, 'no_edit': True}"/>
                            <field name="target_lang_id" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_edit': True}"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="processed_date" readonly="1"/>
                            <field name="processing_duration" readonly="1" widget="float_time"/>
                            <field name="create_uid" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Instructions" name="instructions">
                            <field name="system_instructions" readonly="state != 'draft'"
                                   placeholder="Optional: Provide specific tone, style, or formatting instructions for the AI translator..."/>
                        </page>
                        
                        <page string="Error Details" name="error_details" invisible="state != 'error'">
                            <group>
                                <field name="error_message" readonly="1" nolabel="1"/>
                            </group>
                        </page>
                        
                        <page string="Content" name="content" invisible="state in ('draft', 'in_progress')">
                            <group string="Translation Content">
                                <group string="Original Content">
                                    <field name="original_content" widget="json" readonly="1" nolabel="1"/>
                                </group>
                                <group string="Translated Content">
                                    <field name="translated_content" widget="json" readonly="1" nolabel="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View for Translation Tasks with default_group_by -->
    <record id="view_sc_translation_task_kanban" model="ir.ui.view">
        <field name="name">sc.translation.task.kanban</field>
        <field name="model">sc.translation.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="blog_post_id"/>
                <field name="target_lang_id"/>
                <field name="state"/>
                <field name="create_date"/>
                <field name="processed_date"/>
                <field name="processing_duration"/>
                <field name="create_uid"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title">
                                    <field name="name"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="o_kanban_record_subtitle">
                                        <i class="fa fa-file-text-o"/> <field name="blog_post_id"/>
                                    </div>
                                    <div class="o_kanban_record_subtitle">
                                        <i class="fa fa-language"/> <field name="target_lang_id"/>
                                    </div>
                                    <div class="o_kanban_record_subtitle" t-if="record.processing_duration.raw_value">
                                        <i class="fa fa-clock-o"/> <field name="processing_duration" widget="float_time"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="create_date" widget="date"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <img t-att-src="kanban_image('res.users', 'avatar_128', record.create_uid.raw_value)" 
                                             t-att-title="record.create_uid.value" 
                                             t-att-alt="record.create_uid.value" 
                                             class="oe_kanban_avatar o_image_24_cover"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View for Translation Tasks -->
    <record id="view_sc_translation_task_search" model="ir.ui.view">
        <field name="name">sc.translation.task.search</field>
        <field name="model">sc.translation.task</field>
        <field name="arch" type="xml">
            <search string="Translation Tasks">
                <field name="name" string="Task"/>
                <field name="blog_post_id" string="Blog Post"/>
                <field name="target_lang_id" string="Target Language"/>
                <field name="create_uid" string="Created by"/>
                
                <filter string="My Tasks" name="my_tasks" 
                        domain="[('create_uid', '=', uid)]"/>
                <filter string="Active Tasks" name="active_tasks" 
                        domain="[('state', 'in', ['draft', 'in_progress'])]"/>
                <filter string="Completed" name="completed" 
                        domain="[('state', '=', 'done')]"/>
                <filter string="Errors" name="errors" 
                        domain="[('state', '=', 'error')]"/>
                
                <separator/>
                <filter string="Today" name="today" 
                        domain="[('create_date', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter string="This Week" name="this_week" 
                        domain="[('create_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Target Language" name="group_language" context="{'group_by': 'target_lang_id'}"/>
                    <filter string="Blog Post" name="group_blog_post" context="{'group_by': 'blog_post_id'}"/>
                    <filter string="Created by" name="group_user" context="{'group_by': 'create_uid'}"/>
                    <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
