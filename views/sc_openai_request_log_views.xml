<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions for OpenAI Request Logs -->
    <record id="action_sc_openai_request_log" model="ir.actions.act_window">
        <field name="name">Request History</field>
        <field name="res_model">sc.openai.request.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No OpenAI request logs found!
            </p>
            <p>
                Request logs are automatically created when OpenAI API calls are made.
                Try using the translation features to generate some logs.
            </p>
        </field>
    </record>

    <record id="action_sc_openai_request_analytics" model="ir.actions.act_window">
        <field name="name">Request Analytics</field>
        <field name="res_model">sc.openai.request.log</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_by_model': 1, 'search_default_successful': 1}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No request analytics data available!
            </p>
            <p>
                Analytics data will appear here once OpenAI requests are made.
                Use the various filters to analyze performance patterns.
            </p>
        </field>
    </record>

    <!-- OpenAI Request Log Search View -->
    <record id="view_sc_openai_request_log_search" model="ir.ui.view">
        <field name="name">sc.openai.request.log.search</field>
        <field name="model">sc.openai.request.log</field>
        <field name="arch" type="xml">
            <search string="Search OpenAI Request Logs">
                <!-- Search Fields -->
                <field name="request_id" string="Request ID"/>
                <field name="model_used" string="OpenAI Model"/>
                <field name="operation_type" string="Operation"/>
                <field name="related_record_name" string="Related Record"/>
                <field name="user_id" string="User"/>
                
                <!-- Filters -->
                <filter name="today" string="Today" 
                        domain="[('timestamp', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('timestamp', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <filter name="yesterday" string="Yesterday" 
                        domain="[('timestamp', '&gt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d 00:00:00')), ('timestamp', '&lt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter name="this_week" string="This Week" 
                        domain="[('timestamp', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="this_month" string="This Month" 
                        domain="[('timestamp', '&gt;=', context_today().replace(day=1).strftime('%Y-%m-%d 00:00:00'))]"/>
                
                <separator/>
                <filter name="successful" string="Successful" domain="[('status', '=', 'success')]"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'error')]"/>
                <filter name="high_cost" string="High Cost (&gt; $0.10)" domain="[('estimated_cost', '&gt;', 0.10)]"/>
                <filter name="slow_response" string="Slow Response (&gt; 10s)" domain="[('response_time_ms', '&gt;', 10000)]"/>
                
                <separator/>
                <filter name="translation_requests" string="Translation" domain="[('operation_type', 'ilike', 'translation')]"/>
                <filter name="content_generation" string="Content Generation" domain="[('operation_type', 'ilike', 'generation')]"/>
                
                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter name="group_by_model" string="Model" context="{'group_by': 'model_used'}"/>
                    <filter name="group_by_operation" string="Operation" context="{'group_by': 'operation_type'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'timestamp:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- OpenAI Request Log List View -->
    <record id="view_sc_openai_request_log_list" model="ir.ui.view">
        <field name="name">sc.openai.request.log.list</field>
        <field name="model">sc.openai.request.log</field>
        <field name="arch" type="xml">
            <list string="OpenAI Request Logs" create="false" edit="false" delete="false">
                <header>
                    <button name="action_cleanup_old_logs" string="Cleanup Old Logs" type="object" class="btn-secondary"/>
                </header>
                <field name="timestamp"/>
                <field name="model_used"/>
                <field name="operation_type"/>
                <field name="total_tokens" sum="Total"/>
                <field name="estimated_cost" sum="Total Cost"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="response_time_ms"/>
                <field name="status"/>
                <field name="user_id"/>
                <field name="related_record_name"/>
            </list>
        </field>
    </record>

    <!-- OpenAI Request Log Form View -->
    <record id="view_sc_openai_request_log_form" model="ir.ui.view">
        <field name="name">sc.openai.request.log.form</field>
        <field name="model">sc.openai.request.log</field>
        <field name="arch" type="xml">
            <form string="OpenAI Request Log" create="false" edit="false" delete="false">
                <header>
                    <button name="action_view_related_record" string="View Related Record" 
                            type="object" class="btn-primary"
                            invisible="not related_model or not related_record_id"
                            icon="fa-external-link"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                        <h2 class="text-muted">
                            Request ID: <field name="request_id" readonly="1" nolabel="1"/>
                        </h2>
                    </div>
                    
                    <group>
                        <group name="request_info" string="Request Information">
                            <field name="timestamp"/>
                            <field name="model_used"/>
                            <field name="operation_type"/>
                            <field name="user_id"/>
                        </group>
                        <group name="metrics" string="Performance Metrics">
                            <field name="response_time_ms"/>
                            <field name="prompt_tokens"/>
                            <field name="completion_tokens"/>
                            <field name="total_tokens"/>
                        </group>
                    </group>
                    
                    <group>
                        <group name="cost_info" string="Cost Information">
                            <field name="estimated_cost"/>
                            <field name="currency_id"/>
                            <field name="cost_per_token"/>
                        </group>
                        <group name="related_info" string="Related Record">
                            <field name="related_model"/>
                            <field name="related_record_id"/>
                            <field name="related_record_name"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Error Details" name="error_details" invisible="status == 'success'">
                            <group>
                                <field name="error_message" widget="text" readonly="1"/>
                            </group>
                        </page>
                        
                        <page string="Additional Info" name="additional_info">
                            <group>
                                <field name="company_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- OpenAI Request Log Kanban View -->
    <record id="view_sc_openai_request_log_kanban" model="ir.ui.view">
        <field name="name">sc.openai.request.log.kanban</field>
        <field name="model">sc.openai.request.log</field>
        <field name="arch" type="xml">
            <kanban string="OpenAI Request Logs" default_group_by="status" create="false" edit="false" delete="false">
                <field name="request_id"/>
                <field name="model_used"/>
                <field name="operation_type"/>
                <field name="timestamp"/>
                <field name="total_tokens"/>
                <field name="estimated_cost"/>
                <field name="currency_id"/>
                <field name="response_time_ms"/>
                <field name="status"/>
                <field name="user_id"/>
                <field name="related_record_name"/>
                <field name="error_message"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <!-- Header with model and status -->
                                <div class="row">
                                    <div class="col-8">
                                        <strong t-esc="record.model_used.value"/>
                                        <br/>
                                        <small class="text-muted" t-esc="record.operation_type.value"/>
                                    </div>
                                    <div class="col-4 text-end">
                                        <span t-if="record.status.raw_value == 'success'" class="badge badge-success">✓</span>
                                        <span t-if="record.status.raw_value == 'error'" class="badge badge-danger">✗</span>
                                    </div>
                                </div>
                                
                                <!-- Metrics row -->
                                <div class="row mt-2">
                                    <div class="col-6">
                                        <small class="text-muted">Tokens:</small>
                                        <br/>
                                        <strong t-esc="record.total_tokens.value"/>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Cost:</small>
                                        <br/>
                                        <strong>$<t t-esc="record.estimated_cost.value"/></strong>
                                    </div>
                                </div>
                                
                                <!-- Response time and timestamp -->
                                <div class="row mt-2">
                                    <div class="col-6">
                                        <small class="text-muted">Response:</small>
                                        <br/>
                                        <span t-esc="record.response_time_ms.value"/>ms
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Time:</small>
                                        <br/>
                                        <small t-esc="record.timestamp.value"/>
                                    </div>
                                </div>
                                
                                <!-- Related record if available -->
                                <div t-if="record.related_record_name.value" class="row mt-2">
                                    <div class="col-12">
                                        <small class="text-muted">Related:</small>
                                        <br/>
                                        <small t-esc="record.related_record_name.value"/>
                                    </div>
                                </div>
                                
                                <!-- Error message for failed requests -->
                                <div t-if="record.status.raw_value == 'error' and record.error_message.value" class="row mt-2">
                                    <div class="col-12">
                                        <small class="text-danger" t-esc="record.error_message.value"/>
                                    </div>
                                </div>
                                
                                <!-- User info -->
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <small class="text-muted">
                                            <i class="fa fa-user"/> <t t-esc="record.user_id.value"/>
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- OpenAI Request Log Search View -->
    <record id="view_sc_openai_request_log_search" model="ir.ui.view">
        <field name="name">sc.openai.request.log.search</field>
        <field name="model">sc.openai.request.log</field>
        <field name="arch" type="xml">
            <search string="Search OpenAI Request Logs">
                <!-- Quick filters -->
                <field name="model_used"/>
                <field name="operation_type"/>
                <field name="status"/>
                <field name="user_id"/>
                <field name="related_record_name"/>
                
                <!-- Date filters -->
                <filter name="today" string="Today" 
                        domain="[('timestamp', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                ('timestamp', '&lt;', datetime.datetime.combine(context_today() + datetime.timedelta(days=1), datetime.time(0,0,0)))]"/>
                <filter name="yesterday" string="Yesterday"
                        domain="[('timestamp', '&gt;=', datetime.datetime.combine(context_today() - datetime.timedelta(days=1), datetime.time(0,0,0))),
                                ('timestamp', '&lt;', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter name="last_7_days" string="Last 7 Days"
                        domain="[('timestamp', '&gt;=', datetime.datetime.combine(context_today() - datetime.timedelta(days=7), datetime.time(0,0,0)))]"/>
                <filter name="last_30_days" string="Last 30 Days"
                        domain="[('timestamp', '&gt;=', datetime.datetime.combine(context_today() - datetime.timedelta(days=30), datetime.time(0,0,0)))]"/>
                
                <separator/>
                
                <!-- Status filters -->
                <filter name="successful" string="Successful" domain="[('status', '=', 'success')]"/>
                <filter name="failed" string="Failed" domain="[('status', '!=', 'success')]"/>
                <filter name="errors" string="Errors" domain="[('status', '=', 'error')]"/>
                <filter name="timeouts" string="Timeouts" domain="[('status', '=', 'timeout')]"/>
                
                <separator/>
                
                <!-- Model filters -->
                <filter name="gpt4o" string="GPT-4o" domain="[('model_used', '=', 'gpt-4o')]"/>
                <filter name="gpt4turbo" string="GPT-4 Turbo" domain="[('model_used', '=', 'gpt-4-turbo')]"/>
                <filter name="gpt35" string="GPT-3.5 Turbo" domain="[('model_used', '=', 'gpt-3.5-turbo')]"/>
                
                <separator/>
                
                <!-- Operation filters -->
                <filter name="translation" string="Translation" domain="[('operation_type', '=', 'translation')]"/>
                <filter name="generation" string="Generation" domain="[('operation_type', '=', 'generation')]"/>
                <filter name="analysis" string="Analysis" domain="[('operation_type', '=', 'analysis')]"/>
                
                <separator/>
                
                <!-- High usage filters -->
                <filter name="high_token_usage" string="High Token Usage (&gt;5000)" 
                        domain="[('total_tokens', '&gt;', 5000)]"/>
                <filter name="expensive" string="Expensive (&gt;$0.10)" 
                        domain="[('estimated_cost', '&gt;', 0.10)]"/>
                <filter name="slow_response" string="Slow Response (&gt;10s)" 
                        domain="[('response_time_ms', '&gt;', 10000)]"/>
                
                <!-- Group by options -->
                <group expand="0" string="Group By">
                    <filter name="group_by_model" string="Model" context="{'group_by': 'model_used'}"/>
                    <filter name="group_by_operation" string="Operation" context="{'group_by': 'operation_type'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'timestamp:day'}"/>
                    <filter name="group_by_related_model" string="Related Model" context="{'group_by': 'related_model'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- OpenAI Request Log Kanban View -->
    <record id="view_sc_openai_request_log_kanban" model="ir.ui.view">
        <field name="name">sc.openai.request.log.kanban</field>
        <field name="model">sc.openai.request.log</field>
        <field name="arch" type="xml">
            <kanban string="OpenAI Requests" default_group_by="status" create="false" edit="false" delete="false">
                <field name="id"/>
                <field name="timestamp"/>
                <field name="model_used"/>
                <field name="operation_type"/>
                <field name="total_tokens"/>
                <field name="estimated_cost"/>
                <field name="response_time_ms"/>
                <field name="status"/>
                <field name="related_record_name"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <strong><field name="model_used"/></strong>
                                        <span class="badge badge-secondary ml-1">
                                            <field name="operation_type"/>
                                        </span>
                                    </div>
                                    <div class="o_secondary">
                                        <field name="timestamp" widget="relative"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_card_content">
                                <div class="row">
                                    <div class="col-6">
                                        <strong>Tokens:</strong> <field name="total_tokens"/>
                                    </div>
                                    <div class="col-6">
                                        <strong>Cost:</strong> $<field name="estimated_cost"/>
                                    </div>
                                </div>
                                <div class="row mt-1">
                                    <div class="col-6">
                                        <strong>Time:</strong> <field name="response_time_ms"/>ms
                                    </div>
                                    <div class="col-6" t-if="record.related_record_name.value">
                                        <strong>Record:</strong> <field name="related_record_name"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- OpenAI Request Log Action -->
    <record id="action_sc_openai_request_log" model="ir.actions.act_window">
        <field name="name">OpenAI Request History</field>
        <field name="res_model">sc.openai.request.log</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="target">current</field>
        <field name="context">{
            'search_default_last_7_days': 1,
            'search_default_group_by_model': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No OpenAI requests recorded yet!
            </p>
            <p>
                This view shows detailed logs of all OpenAI API requests made by the system.
                <br/>
                Each request is tracked with performance metrics, cost estimation, and related record information.
            </p>
        </field>
    </record>

    <!-- Request Log Analytics Action -->
    <record id="action_sc_openai_request_analytics" model="ir.actions.act_window">
        <field name="name">Request Analytics</field>
        <field name="res_model">sc.openai.request.log</field>
        <field name="view_mode">pivot,graph</field>
        <field name="context">{
            'search_default_last_30_days': 1
        }</field>
    </record>

    <!-- Pivot View for Analytics -->
    <record id="view_sc_openai_request_log_pivot" model="ir.ui.view">
        <field name="name">sc.openai.request.log.pivot</field>
        <field name="model">sc.openai.request.log</field>
        <field name="arch" type="xml">
            <pivot string="OpenAI Request Analytics">
                <field name="model_used" type="row"/>
                <field name="operation_type" type="row"/>
                <field name="timestamp" type="col" interval="day"/>
                <field name="total_tokens" type="measure"/>
                <field name="estimated_cost" type="measure"/>
                <field name="response_time_ms" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View for Analytics -->
    <record id="view_sc_openai_request_log_graph" model="ir.ui.view">
        <field name="name">sc.openai.request.log.graph</field>
        <field name="model">sc.openai.request.log</field>
        <field name="arch" type="xml">
            <graph string="OpenAI Request Trends">
                <field name="timestamp" type="row" interval="day"/>
                <field name="total_tokens" type="measure"/>
                <field name="estimated_cost" type="measure"/>
            </graph>
        </field>
    </record>
</odoo>