<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Translation Wizard Form View -->
    <record id="view_sc_translate_blog_post_wizard_form" model="ir.ui.view">
        <field name="name">sc.translate.blog.post.wizard.form</field>
        <field name="model">sc.translate.blog.post.wizard</field>
        <field name="arch" type="xml">
            <form string="Translate Blog Posts">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            Translate Blog Posts
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Blog Post Selection">
                            <field name="blog_post_ids" widget="many2many_tags" 
                                   domain="[('website_published', '=', True)]"
                                   required="1"/>
                            <field name="blog_post_count" readonly="1"/>
                        </group>
                        
                        <group string="Translation Settings">
                            <field name="target_lang_id" required="1" 
                                   domain="[('website_published', '=', True)]"/>
                            <field name="estimated_cost" readonly="1"/>
                        </group>
                    </group>
                    
                    <group string="AI Instructions">
                        <field name="system_instructions" widget="text" 
                               placeholder="Optional: Provide specific tone, style, or formatting instructions..."/>
                    </group>
                    
                    <!-- Warning Messages -->
                    <div class="alert alert-info" role="alert" 
                         invisible="not blog_post_ids">
                        <strong>Selected Posts:</strong> <field name="blog_post_count" readonly="1"/> blog posts will be translated.
                    </div>
                    
                    <div class="alert alert-warning" role="alert" 
                         invisible="not estimated_cost">
                        <strong>Estimated Cost:</strong> <field name="estimated_cost" readonly="1"/>
                    </div>
                </sheet>
                
                <footer>
                    <button name="action_translate" type="object" 
                            string="Create Translation Task" 
                            class="btn-primary"
                            invisible="not blog_post_ids or not target_lang_id"/>
                    <button name="action_preview_content" type="object" 
                            string="Preview Content" 
                            class="btn-secondary"
                            invisible="not blog_post_ids"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Translation Wizard Action -->
    <record id="action_sc_translate_blog_post_wizard" model="ir.actions.act_window">
        <field name="name">Translate Blog Posts</field>
        <field name="res_model">sc.translate.blog.post.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_blog_post_ids': active_ids if active_model == 'blog.post' else [],
        }</field>
    </record>
</odoo>
