<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sc.marketing.automation.tool</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Add our settings as a new block within the Integrations section -->
            <xpath expr="//setting[@id='module_auth_oauth']" position="after">
                <setting id="sc_openai_integration_setting" string="AI Marketing Tools">
                    <div class="content-group">
                        <div class="mt16">
                            <label for="sc_openai_api_key" class="o_light_label">OpenAI API Key</label>
                            <field name="sc_openai_api_key" placeholder="sk-..." password="True"/>
                            <div class="text-muted">
                                Your OpenAI API key for accessing AI translation services.
                                <a href="https://platform.openai.com/api-keys" target="_blank" class="oe_link">
                                    Get your API key here
                                </a>
                            </div>
                        </div>
                        <div class="mt16">
                            <label for="sc_openai_organization_id" class="o_light_label">OpenAI Organization ID</label>
                            <field name="sc_openai_organization_id" placeholder="org-..."/>
                            <div class="text-muted">
                                Your OpenAI Organization ID (optional but recommended).
                            </div>
                        </div>
                        <div class="mt16">
                            <label for="sc_openai_model" class="o_light_label">OpenAI Model</label>
                            <field name="sc_openai_model"/>
                            <div class="text-muted">
                                Select the OpenAI model to use for content translations.
                                Model list is loaded dynamically from your OpenAI account.
                            </div>
                        </div>
                    </div>
                </setting>
                
                <!-- Content Research Agent Settings v18.0.1.0.1 -->
                <setting id="sc_research_agent_setting" string="Content Research Agent">
                    <div class="content-group">
                        <div class="mt16">
                            <label for="sc_research_agent_model" class="o_light_label">Research Agent Model</label>
                            <field name="sc_research_agent_model"/>
                            <div class="text-muted">
                                OpenAI model for content research and topic generation.
                            </div>
                        </div>
                        <div class="mt16">
                            <label for="sc_research_agent_instructions" class="o_light_label">Agent Instructions</label>
                            <field name="sc_research_agent_instructions"/>
                            <div class="text-muted">
                                System instructions that guide the research agent behavior.
                            </div>
                        </div>
                        <div class="mt16">
                            <label for="sc_research_agent_default_query" class="o_light_label">Default Search Query</label>
                            <field name="sc_research_agent_default_query"/>
                            <div class="text-muted">
                                Default search query template (use {today} for current date).
                            </div>
                        </div>
                    </div>
                </setting>
                
                <!-- Content Generation Agent Settings v18.0.1.0.1 -->
                <setting id="sc_generation_agent_setting" string="Content Generation Agent">
                    <div class="content-group">
                        <div class="mt16">
                            <label for="sc_generation_agent_model" class="o_light_label">Generation Agent Model</label>
                            <field name="sc_generation_agent_model"/>
                            <div class="text-muted">
                                OpenAI model for blog content generation.
                            </div>
                        </div>
                        <div class="mt16">
                            <label for="sc_generation_agent_instructions" class="o_light_label">Agent Instructions</label>
                            <field name="sc_generation_agent_instructions"/>
                            <div class="text-muted">
                                System instructions for the content generation agent.
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
