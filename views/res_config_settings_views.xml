<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sc.marketing.automation.tool</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Add our settings as a new block within the Integrations section -->
            <xpath expr="//setting[@id='module_auth_oauth']" position="after">
                <setting id="sc_openai_integration_setting" string="AI Marketing Tools">
                    <div class="content-group">
                        <div class="mt16">
                            <label for="sc_openai_api_key" class="o_light_label">OpenAI API Key</label>
                            <field name="sc_openai_api_key" placeholder="sk-..." password="True"/>
                            <div class="text-muted">
                                Your OpenAI API key for accessing AI translation services.
                                <a href="https://platform.openai.com/api-keys" target="_blank" class="oe_link">
                                    Get your API key here
                                </a>
                            </div>
                        </div>
                        <div class="mt16">
                            <label for="sc_openai_organization_id" class="o_light_label">OpenAI Organization ID</label>
                            <field name="sc_openai_organization_id" placeholder="org-..."/>
                            <div class="text-muted">
                                Your OpenAI Organization ID (optional but recommended).
                            </div>
                        </div>
                        <div class="mt16">
                            <label for="sc_openai_model" class="o_light_label">OpenAI Model</label>
                            <field name="sc_openai_model"/>
                            <div class="text-muted">
                                Select the OpenAI model to use for content translations.
                                Model list is loaded dynamically from your OpenAI account.
                            </div>
                        </div>
                    </div>
                </setting>
                
                <!-- AI Agent Configuration v18.0.1.0.1 -->
                <setting id="sc_ai_agent_setting" string="AI Agent Management">
                    <div class="content-group">
                        <div class="mt16">
                            <field name="sc_enable_agent_config"/>
                            <label for="sc_enable_agent_config" class="o_light_label">Enable Advanced Agent Management</label>
                            <div class="text-muted">
                                Enable comprehensive AI agent configuration system with custom instructions, models, and templates.
                            </div>
                        </div>
                        <div class="mt16" invisible="not sc_enable_agent_config">
                            <div class="alert alert-info">
                                <strong>Advanced AI Agent Configuration is Active!</strong><br/>
                                Configure your AI agents with detailed instructions, custom models, and specialized templates.
                                <br/><br/>
                                <button name="%(action_sc_ai_agent_config)d" 
                                        string="Manage AI Agent Configurations" 
                                        type="action" 
                                        class="btn btn-primary btn-sm"
                                        icon="fa-cogs"/>
                            </div>
                        </div>
                    </div>
                </setting>
                
                <!-- Legacy Agent Model Settings (for backward compatibility) -->
                <setting id="sc_legacy_agent_setting" string="Legacy Agent Models" invisible="sc_enable_agent_config">
                    <div class="content-group">
                        <div class="mt16">
                            <label for="sc_research_agent_model" class="o_light_label">Research Agent Model</label>
                            <field name="sc_research_agent_model"/>
                            <div class="text-muted">
                                OpenAI model for content research (legacy setting - upgrade to advanced agent management).
                            </div>
                        </div>
                        <div class="mt16">
                            <label for="sc_generation_agent_model" class="o_light_label">Generation Agent Model</label>
                            <field name="sc_generation_agent_model"/>
                            <div class="text-muted">
                                OpenAI model for content generation (legacy setting - upgrade to advanced agent management).
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
