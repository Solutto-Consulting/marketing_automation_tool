<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Marketing Automation Configuration in General Settings -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.marketing.automation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <setting string="Marketing Automation" help="Configure automated marketing workflows with external services" id="marketing_automation_setting">
                    <field name="marketing_automation_url" placeholder="https://your-n8n-instance.com/webhook/translate"/>
                    <div class="content-group" invisible="not marketing_automation_url">
                        <div class="row mt16">
                            <label for="marketing_automation_token" class="col-lg-3 o_light_label" string="Auth Token"/>
                            <field name="marketing_automation_token" placeholder="Your authentication token" password="True"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
