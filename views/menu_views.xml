<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Marketing Automation Root Menu -->
    <record id="menu_marketing_automation_root" model="ir.ui.menu">
        <field name="name">Marketing Automation</field>
        <field name="sequence" eval="60"/>
        <field name="web_icon">sc_marketing_automation_tool,static/description/icon.png</field>
    </record>

    <!-- Content Generation Sub-menu -->
    <record id="menu_content_generation" model="ir.ui.menu">
        <field name="name">Content Generation</field>
        <field name="parent_id" ref="menu_marketing_automation_root"/>
        <field name="sequence" eval="5"/>
    </record>

    <!-- Content Ideas Menu -->
    <record id="menu_content_ideas" model="ir.ui.menu">
        <field name="name">Content Ideas</field>
        <field name="parent_id" ref="menu_content_generation"/>
        <field name="action" ref="action_sc_content_idea"/>
        <field name="sequence" eval="10"/>
    </record>

    <!-- Generate Ideas Wizard Menu -->
    <record id="menu_generate_ideas_wizard" model="ir.ui.menu">
        <field name="name">Generate Ideas</field>
        <field name="parent_id" ref="menu_content_generation"/>
        <field name="action" ref="action_sc_generate_ideas_wizard"/>
        <field name="sequence" eval="20"/>
    </record>

    <!-- Generate Content Wizard Menu -->
    <record id="menu_generate_content_wizard" model="ir.ui.menu">
        <field name="name">Generate Content</field>
        <field name="parent_id" ref="menu_content_generation"/>
        <field name="action" ref="action_sc_generate_content_wizard"/>
        <field name="sequence" eval="30"/>
    </record>

    <!-- Task Management Sub-menu -->
    <record id="menu_task_management" model="ir.ui.menu">
        <field name="name">Task Management</field>
        <field name="parent_id" ref="menu_marketing_automation_root"/>
        <field name="sequence" eval="10"/>
    </record>

    <!-- Research Tasks Menu -->
    <record id="menu_content_idea_tasks" model="ir.ui.menu">
        <field name="name">Research Tasks</field>
        <field name="parent_id" ref="menu_task_management"/>
        <field name="action" ref="action_sc_content_idea_task"/>
        <field name="sequence" eval="10"/>
    </record>

    <!-- Generation Tasks Menu -->
    <record id="menu_content_generation_tasks" model="ir.ui.menu">
        <field name="name">Generation Tasks</field>
        <field name="parent_id" ref="menu_task_management"/>
        <field name="action" ref="action_sc_content_generation_task"/>
        <field name="sequence" eval="20"/>
    </record>



    <!-- Analytics Sub-menu -->
    <record id="menu_analytics" model="ir.ui.menu">
        <field name="name">Analytics</field>
        <field name="parent_id" ref="menu_marketing_automation_root"/>
        <field name="sequence" eval="15"/>
    </record>

    <!-- NEW: Request History Menu -->
    <record id="menu_openai_request_history" model="ir.ui.menu">
        <field name="name">Request History</field>
        <field name="parent_id" ref="menu_analytics"/>
        <field name="action" ref="action_sc_openai_request_log"/>
        <field name="sequence" eval="40"/>
    </record>

    <!-- NEW: Model Statistics Menu -->
    <record id="menu_openai_model_statistics" model="ir.ui.menu">
        <field name="name">Model Statistics</field>
        <field name="parent_id" ref="menu_analytics"/>
        <field name="action" ref="action_sc_openai_model_statistics"/>
        <field name="sequence" eval="50"/>
    </record>

    <!-- NEW: Advanced Analytics Menu -->
    <record id="menu_openai_advanced_analytics" model="ir.ui.menu">
        <field name="name">Advanced Analytics</field>
        <field name="parent_id" ref="menu_analytics"/>
        <field name="action" ref="action_sc_openai_request_analytics"/>
        <field name="sequence" eval="60"/>
    </record>

    <!-- Configuration Sub-menu -->
    <record id="menu_configuration" model="ir.ui.menu">
        <field name="name">Configuration</field>
        <field name="parent_id" ref="menu_marketing_automation_root"/>
        <field name="sequence" eval="100"/>
    </record>

    <!-- Module Settings Menu -->
    <record id="menu_module_settings" model="ir.ui.menu">
        <field name="name">Settings</field>
        <field name="parent_id" ref="menu_configuration"/>
        <field name="action" ref="action_sc_marketing_automation_settings"/>
        <field name="sequence" eval="5"/>
    </record>

    <!-- AI Agent Configurations Menu -->
    <record id="menu_ai_agent_config" model="ir.ui.menu">
        <field name="name">AI Agent Configurations</field>
        <field name="parent_id" ref="menu_configuration"/>
        <field name="action" ref="action_sc_ai_agent_config"/>
        <field name="sequence" eval="10"/>
    </record>

</odoo>
