<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Content Generation Task Tree View -->
        <record id="sc_content_generation_task_view_tree" model="ir.ui.view">
            <field name="name">sc.content.generation.task.tree</field>
            <field name="model">sc.content.generation.task</field>
            <field name="arch" type="xml">
                <list string="Content Generation Tasks">
                    <field name="name"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'done'"
                           decoration-info="state == 'in_progress'"
                           decoration-warning="state == 'draft'"
                           decoration-danger="state == 'error'"/>
                    <field name="source_title"/>
                    <field name="target_blog_id"/>
                    <field name="target_lang_id"/>
                    <field name="generated_blog_post_id"/>
                    <field name="duration"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>

        <!-- Content Generation Task Form View -->
        <record id="sc_content_generation_task_view_form" model="ir.ui.view">
            <field name="name">sc.content.generation.task.form</field>
            <field name="model">sc.content.generation.task</field>
            <field name="arch" type="xml">
                <form string="Content Generation Task">
                    <header>
                        <button name="action_start_processing" type="object" string="Queue for Processing" 
                                class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_retry" type="object" string="Retry" 
                                class="btn-secondary" invisible="state not in ('error', 'done')"/>
                        <button name="action_view_blog_post" type="object" string="View Generated Post" 
                                class="oe_highlight" invisible="not generated_blog_post_id"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_blog_post" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                    invisible="not generated_blog_post_id">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Blog Post</span>
                                    <span class="o_stat_value">Generated</span>
                                </div>
                            </button>
                        </div>
                        
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="state"/>
                                <field name="content_idea_id"/>
                            </group>
                            <group>
                                <field name="target_blog_id"/>
                                <field name="target_author_id"/>
                                <field name="target_lang_id"/>
                            </group>
                        </group>
                        
                        <group>
                            <group>
                                <field name="started_at" readonly="1"/>
                                <field name="completed_at" readonly="1"/>
                            </group>
                            <group>
                                <field name="duration" readonly="1"/>
                                <field name="generated_blog_post_id" readonly="1"/>
                            </group>
                        </group>
                        
                        <group string="Source Content (from Content Idea)">
                            <field name="source_title" readonly="1"/>
                            <field name="source_url" readonly="1" widget="url"/>
                            <field name="source_summary" readonly="1"/>
                        </group>
                        
                        <group string="Additional Instructions">
                            <field name="user_prompt" nolabel="1"/>
                        </group>
                        
                        <group string="Agent Configuration (At Execution)" invisible="not agent_model">
                            <field name="agent_model" readonly="1"/>
                            <field name="agent_instructions" readonly="1"/>
                        </group>
                        
                        <group string="Error Details" invisible="state != 'error'">
                            <field name="error_message" nolabel="1" readonly="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Content Generation Task Search View -->
        <record id="sc_content_generation_task_view_search" model="ir.ui.view">
            <field name="name">sc.content.generation.task.search</field>
            <field name="model">sc.content.generation.task</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Task Name"/>
                    <field name="source_title" string="Source Title"/>
                    <field name="target_blog_id" string="Target Blog"/>
                    <field name="target_author_id" string="Author"/>
                    <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter name="done" string="Completed" domain="[('state', '=', 'done')]"/>
                    <filter name="error" string="Failed" domain="[('state', '=', 'error')]"/>
                    <separator/>
                    <filter name="recent" string="Recent (Last 7 Days)" 
                            domain="[('create_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                        <filter name="group_by_blog" string="Target Blog" context="{'group_by': 'target_blog_id'}"/>
                        <filter name="group_by_author" string="Author" context="{'group_by': 'target_author_id'}"/>
                        <filter name="group_by_date" string="Creation Date" context="{'group_by': 'create_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Content Generation Task Kanban View -->
        <record id="sc_content_generation_task_view_kanban" model="ir.ui.view">
            <field name="name">sc.content.generation.task.kanban</field>
            <field name="model">sc.content.generation.task</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="state"/>
                    <field name="source_title"/>
                    <field name="target_blog_id"/>
                    <field name="generated_blog_post_id"/>
                    <field name="error_message"/>
                    <field name="duration"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_title">
                                        <field name="name"/>
                                    </div>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        Source: <field name="source_title"/>
                                    </div>
                                    <div class="mt8">
                                        <span class="badge badge-pill badge-info">
                                            <field name="target_blog_id"/>
                                        </span>
                                    </div>
                                    <div class="mt8" t-if="record.error_message.raw_value">
                                        <span class="text-danger">
                                            <i class="fa fa-exclamation-triangle"/> Error: 
                                            <field name="error_message"/>
                                        </span>
                                    </div>
                                    <div class="o_kanban_record_bottom mt16">
                                        <div class="oe_kanban_bottom_left">
                                            <t t-if="record.duration.raw_value > 0">
                                                <span class="text-muted">
                                                    <i class="fa fa-clock-o"/> <field name="duration"/> min
                                                </span>
                                            </t>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <t t-if="record.state.raw_value == 'draft'">
                                                <button name="action_start_processing" type="object" 
                                                        class="btn btn-sm btn-primary">Start</button>
                                            </t>
                                            <t t-if="record.state.raw_value == 'error'">
                                                <button name="action_retry" type="object" 
                                                        class="btn btn-sm btn-warning">Retry</button>
                                            </t>
                                            <t t-if="record.generated_blog_post_id.raw_value">
                                                <button name="action_view_blog_post" type="object" 
                                                        class="btn btn-sm btn-success">View Post</button>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Content Generation Task Action -->
        <record id="action_sc_content_generation_task" model="ir.actions.act_window">
            <field name="name">Content Generation Tasks</field>
            <field name="res_model">sc.content.generation.task</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_recent': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No content generation tasks yet!
                </p>
                <p>
                    Content generation tasks are created when you request blog content from content ideas.
                    The Content Generation Agent processes these tasks to create complete blog posts.
                </p>
            </field>
        </record>
    </data>
</odoo>
