<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Content Idea Task Tree View -->
        <record id="sc_content_idea_task_view_tree" model="ir.ui.view">
            <field name="name">sc.content.idea.task.tree</field>
            <field name="model">sc.content.idea.task</field>
            <field name="arch" type="xml">
                <list string="Content Research Tasks">
                    <field name="name"/>
                    <field name="state" widget="badge" 
                           decoration-success="state == 'done'"
                           decoration-info="state == 'in_progress'"
                           decoration-warning="state == 'draft'"
                           decoration-danger="state == 'error'"/>
                    <field name="requested_ideas"/>
                    <field name="generated_ideas_count"/>
                    <field name="started_at"/>
                    <field name="duration"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>

        <!-- Content Idea Task Form View -->
        <record id="sc_content_idea_task_view_form" model="ir.ui.view">
            <field name="name">sc.content.idea.task.form</field>
            <field name="model">sc.content.idea.task</field>
            <field name="arch" type="xml">
                <form string="Content Research Task">
                    <header>
                        <button name="action_start_processing" type="object" string="Queue for Processing" 
                                class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_retry" type="object" string="Retry" 
                                class="btn-secondary" invisible="state not in ('error', 'done')"/>
                        <button name="action_view_ideas" type="object" string="View Generated Ideas" 
                                class="oe_highlight" invisible="generated_ideas_count == 0"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_ideas" type="object" class="oe_stat_button" icon="fa-lightbulb-o">
                                <field name="generated_ideas_count" widget="statinfo" string="Ideas Generated"/>
                            </button>
                        </div>
                        
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="requested_ideas"/>
                                <field name="state"/>
                            </group>
                            <group>
                                <field name="started_at" readonly="1"/>
                                <field name="completed_at" readonly="1"/>
                                <field name="duration" readonly="1"/>
                            </group>
                        </group>
                        
                        <group string="Search Configuration">
                            <field name="search_query" nolabel="1"/>
                        </group>
                        
                        <group string="Agent Configuration (At Execution)" invisible="not agent_model">
                            <field name="agent_model" readonly="1"/>
                            <field name="agent_instructions" readonly="1"/>
                        </group>
                        
                        <group string="Error Details" invisible="state != 'error'">
                            <field name="error_message" nolabel="1" readonly="1"/>
                        </group>
                        
                        <notebook>
                            <page string="Generated Ideas" invisible="generated_ideas_count == 0">
                                <field name="generated_ideas_ids" nolabel="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="domain_name"/>
                                        <field name="word_count"/>
                                        <field name="create_date"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Content Idea Task Search View -->
        <record id="sc_content_idea_task_view_search" model="ir.ui.view">
            <field name="name">sc.content.idea.task.search</field>
            <field name="model">sc.content.idea.task</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Task Name"/>
                    <field name="search_query" string="Search Query"/>
                    <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter name="done" string="Completed" domain="[('state', '=', 'done')]"/>
                    <filter name="error" string="Failed" domain="[('state', '=', 'error')]"/>
                    <separator/>
                    <filter name="recent" string="Recent (Last 7 Days)" 
                            domain="[('create_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                        <filter name="group_by_date" string="Creation Date" context="{'group_by': 'create_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Content Idea Task Kanban View -->
        <record id="sc_content_idea_task_view_kanban" model="ir.ui.view">
            <field name="name">sc.content.idea.task.kanban</field>
            <field name="model">sc.content.idea.task</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="state"/>
                    <field name="requested_ideas"/>
                    <field name="generated_ideas_count"/>
                    <field name="search_query"/>
                    <field name="error_message"/>
                    <field name="duration"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_title">
                                        <field name="name"/>
                                    </div>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <t t-if="record.requested_ideas.raw_value">
                                            Requested: <field name="requested_ideas"/> ideas
                                        </t>
                                        <t t-if="record.generated_ideas_count.raw_value > 0">
                                            | Generated: <field name="generated_ideas_count"/>
                                        </t>
                                    </div>
                                    <div class="mt8">
                                        <field name="search_query" widget="text" readonly="1"/>
                                    </div>
                                    <div class="mt8" t-if="record.error_message.raw_value">
                                        <span class="text-danger">
                                            <i class="fa fa-exclamation-triangle"/> Error: 
                                            <field name="error_message"/>
                                        </span>
                                    </div>
                                    <div class="o_kanban_record_bottom mt16">
                                        <div class="oe_kanban_bottom_left">
                                            <t t-if="record.duration.raw_value > 0">
                                                <span class="text-muted">
                                                    <i class="fa fa-clock-o"/> <field name="duration"/> min
                                                </span>
                                            </t>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <t t-if="record.state.raw_value == 'draft'">
                                                <button name="action_start_processing" type="object" 
                                                        class="btn btn-sm btn-primary">Start</button>
                                            </t>
                                            <t t-if="record.state.raw_value == 'error'">
                                                <button name="action_retry" type="object" 
                                                        class="btn btn-sm btn-warning">Retry</button>
                                            </t>
                                            <t t-if="record.generated_ideas_count.raw_value > 0">
                                                <button name="action_view_ideas" type="object" 
                                                        class="btn btn-sm btn-success">View Ideas</button>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Content Idea Task Action -->
        <record id="action_sc_content_idea_task" model="ir.actions.act_window">
            <field name="name">Content Research Tasks</field>
            <field name="res_model">sc.content.idea.task</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_recent': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No research tasks yet!
                </p>
                <p>
                    Content research tasks are created when you generate content ideas.
                    The Content Research Agent processes these tasks to find relevant articles and topics.
                </p>
            </field>
        </record>
    </data>
</odoo>
