<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Blog Post Form View Enhancement -->
    <record id="view_blog_post_form_translation" model="ir.ui.view">
        <field name="name">blog.post.form.translation</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.view_blog_post_form"/>
        <field name="arch" type="xml">
            <!-- Add smart button for translation tasks -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_translation_tasks" type="object" 
                        class="oe_stat_button" icon="fa-language" 
                        invisible="translation_task_count == 0"
                        groups="sc_marketing_automation_tool.group_marketing_automation_user">
                    <field name="translation_task_count" widget="statinfo" string="Translations"/>
                </button>
                
                <button name="action_open_translation_wizard" type="object" 
                        class="oe_stat_button" icon="fa-plus-circle" 
                        string="New Translation"
                        groups="sc_marketing_automation_tool.group_marketing_automation_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Create</span>
                        <span class="o_stat_text">Translation</span>
                    </div>
                </button>
            </xpath>
            
            <!-- Add Translation History page to notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Translation History" name="translation_history"
                      groups="sc_marketing_automation_tool.group_marketing_automation_user">
                    <group>
                        <group>
                            <field name="translation_in_progress" readonly="1"/>
                            <field name="last_translation_date" readonly="1"/>
                            <field name="completed_translation_count" readonly="1"/>
                        </group>
                        <group>
                            <button name="reset_translation_status" type="object" 
                                    string="Reset Translation Status" 
                                    class="btn-secondary"
                                    invisible="not translation_in_progress"
                                    confirm="Reset the translation status for this blog post?"
                                    groups="sc_marketing_automation_tool.group_marketing_automation_manager"/>
                        </group>
                    </group>
                    
                    <separator string="Translation Tasks"/>
                    <field name="translation_task_ids" readonly="1">
                        <list string="Translation Tasks">
                            <field name="name"/>
                            <field name="target_lang_id"/>
                            <field name="state" widget="badge" 
                                   decoration-info="state in ('draft', 'in_progress')"
                                   decoration-success="state == 'done'"
                                   decoration-danger="state == 'error'"/>
                            <field name="create_date"/>
                            <field name="processed_date"/>
                            <field name="create_uid"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    
    <!-- Blog Post List View Enhancement -->
    <record id="view_blog_post_list_translation" model="ir.ui.view">
        <field name="name">blog.post.list.translation</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.view_blog_post_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="translation_task_count" string="Translations"/>
                <field name="translation_in_progress" string="Translating" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
