#. module: marketing_automation_tool
#: code:addons/marketing_automation_tool/models/blog_post.py:0
msgid "This article is already being translated. Please wait for the process to complete."
msgstr "Este artículo ya está siendo traducido. Por favor espere a que el proceso termine."

#. module: marketing_automation_tool
#: code:addons/marketing_automation_tool/models/blog_post.py:0
msgid "Please configure the automation hub URL and token in Settings > General Settings."
msgstr "Por favor configure la URL del hub de automatización y el token en Configuración > Configuración General."

#. module: marketing_automation_tool
#: code:addons/marketing_automation_tool/models/blog_post.py:0
msgid "Article sent to translation service successfully!"
msgstr "¡Artículo enviado al servicio de traducción exitosamente!"

#. module: marketing_automation_tool
#: code:addons/marketing_automation_tool/models/blog_post.py:0
msgid "Failed to connect to translation service. Please check the configuration and try again.\\n\\nError: %s"
msgstr "Falló la conexión al servicio de traducción. Por favor verifique la configuración e intente nuevamente.\\n\\nError: %s"

#. module: marketing_automation_tool
#: code:addons/marketing_automation_tool/models/blog_post.py:0
msgid "An unexpected error occurred. Please contact the administrator.\\n\\nError: %s"
msgstr "Ocurrió un error inesperado. Por favor contacte al administrador.\\n\\nError: %s"

#. module: marketing_automation_tool
#: code:addons/marketing_automation_tool/wizards/blog_post_translation_wizard.py:0
msgid "Same Language Warning"
msgstr "Advertencia de Mismo Idioma"

#. module: marketing_automation_tool
#: code:addons/marketing_automation_tool/wizards/blog_post_translation_wizard.py:0
msgid "You have selected the same language as the current system language. Please select a different target language for translation."
msgstr "Ha seleccionado el mismo idioma que el idioma actual del sistema. Por favor seleccione un idioma destino diferente para la traducción."

#. module: marketing_automation_tool
#: code:addons/marketing_automation_tool/wizards/blog_post_translation_wizard.py:0
msgid "Please select at least one blog post to translate."
msgstr "Por favor seleccione al menos un artículo del blog para traducir."

#. module: marketing_automation_tool
#: code:addons/marketing_automation_tool/wizards/blog_post_translation_wizard.py:0
msgid "Please select a target language for translation."
msgstr "Por favor seleccione un idioma destino para la traducción."

#. module: marketing_automation_tool
#: code:addons/marketing_automation_tool/wizards/blog_post_translation_wizard.py:0
msgid "Target language cannot be the same as the source language. Please select a different language."
msgstr "El idioma destino no puede ser el mismo que el idioma fuente. Por favor seleccione un idioma diferente."

#. module: marketing_automation_tool
#: code:addons/marketing_automation_tool/wizards/blog_post_translation_wizard.py:0
msgid "The following articles are already being translated:\\n%s\\n\\nPlease wait for the translation process to complete."
msgstr "Los siguientes artículos ya están siendo traducidos:\\n%s\\n\\nPor favor espere a que el proceso de traducción termine."

#. module: marketing_automation_tool
#: code:addons/marketing_automation_tool/wizards/blog_post_translation_wizard.py:0
msgid "Successfully sent %d article(s) to translation service for %s."
msgstr "Se enviaron exitosamente %d artículo(s) al servicio de traducción para %s."

#. module: marketing_automation_tool
#: code:addons/marketing_automation_tool/wizards/blog_post_translation_wizard.py:0
msgid "Sent %d out of %d article(s) to translation service.\\n\\nFailed articles:\\n%s"
msgstr "Se enviaron %d de %d artículo(s) al servicio de traducción.\\n\\nArtículos fallidos:\\n%s"

#. module: marketing_automation_tool
#: code:addons/marketing_automation_tool/wizards/blog_post_translation_wizard.py:0
msgid "Failed to send any articles to translation service:\\n%s"
msgstr "Falló el envío de todos los artículos al servicio de traducción:\\n%s"

#. module: marketing_automation_tool
#: view:blog.post.translation.wizard:marketing_automation_tool.blog_post_translation_wizard_view_form
