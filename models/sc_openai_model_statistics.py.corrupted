from odoo import api, fields, models, _
from odoo.exceptions import ValidationError
import logging
from datetime import datetime, timedelta, date

_logger = logging.getLogger(__name__)

class ScOpenaiModelStatistics(models.Model):
    )
    avg_completion_tokens_display = fields.Char(
        string='Avg Output Tokens', 
        compute='_compute_display_fields',
        help="Average completion tokens per request"
    )
    tokens_per_second_display = fields.Char(
        string='Tokens per Second',
        compute='_compute_display_fields',
        help="Processing speed in tokens per second"
    )
    cost_per_1k_tokens_display = fields.Char(
        string='Cost per 1K Tokens',
        compute='_compute_display_fields',
        help="Cost efficiency per 1000 tokens"
    )

    @api.depends('successful_requests', 'total_requests')
    def _compute_success_rate(self):
        """Calculate success rate percentage"""
        for record in self:
            if record.total_requests > 0:
                record.success_rate = (record.successful_requests / record.total_requests) * 100
            else:
                record.success_rate = 0.0

    @api.depends('total_requests', 'total_prompt_tokens', 'total_completion_tokens', 
                 'total_tokens', 'avg_response_time', 'total_cost')
    def _compute_display_fields(self):
        """Calculate display values for form view"""
        for record in self:
            # Average prompt tokens per request
            if record.total_requests > 0:
                record.avg_prompt_tokens_display = str(int(record.total_prompt_tokens / record.total_requests))
            else:
                record.avg_prompt_tokens_display = "0"
            
            # Average completion tokens per request  
            if record.total_requests > 0:
                record.avg_completion_tokens_display = str(int(record.total_completion_tokens / record.total_requests))
            else:
                record.avg_completion_tokens_display = "0"
            
            # Tokens per second calculation
            if record.avg_response_time > 0 and record.total_requests > 0:
                tokens_per_second = round((record.total_tokens / record.total_requests) / (record.avg_response_time / 1000), 2)
                record.tokens_per_second_display = str(tokens_per_second)
            else:
                record.tokens_per_second_display = "N/A"
            
            # Cost per 1K tokens
            if record.total_tokens > 0:
                cost_per_1k = round((record.total_cost / record.total_tokens) * 1000, 4)
                record.cost_per_1k_tokens_display = f"${cost_per_1k}"
            else:
                record.cost_per_1k_tokens_display = "N/A"ging.getLogger(__name__)

class ScOpenaiModelStatistics(models.Model):
    """Aggregated OpenAI usage statistics by model and time period"""
    _name = 'sc.openai.model.statistics'
    _description = 'OpenAI Model Usage Statistics'
    _order = 'date desc, model_name'
    _rec_name = 'display_name'

    # Period and Model Identification
    date = fields.Date(
        string='Date', 
        required=True, 
        index=True,
        default=fields.Date.today,
        help="Date for this statistics period"
    )
    model_name = fields.Selection([
        ('gpt-4o', 'GPT-4o'),
        ('gpt-4o-mini', 'GPT-4o Mini'),
        ('gpt-4-turbo', 'GPT-4 Turbo'),
        ('gpt-4', 'GPT-4'),
        ('gpt-3.5-turbo', 'GPT-3.5 Turbo'),
        ('other', 'Other Model'),
    ], string='Model', required=True, index=True)
    
    # Aggregated Request Metrics
    total_requests = fields.Integer(
        string='Total Requests',
        default=0,
        help="Total number of API requests for this model on this date"
    )
    successful_requests = fields.Integer(
        string='Successful Requests',
        default=0,
        help="Number of successful API requests"
    )
    failed_requests = fields.Integer(
        string='Failed Requests',
        default=0,
        help="Number of failed API requests"
    )
    
    # Token Usage Metrics
    total_prompt_tokens = fields.Integer(
        string='Total Input Tokens',
        default=0,
        help="Total input tokens used for this model on this date"
    )
    total_completion_tokens = fields.Integer(
        string='Total Output Tokens',
        default=0,
        help="Total output tokens generated for this model on this date"
    )
    total_tokens = fields.Integer(
        string='Total Tokens',
        compute='_compute_total_tokens',
        store=True,
        help="Sum of input and output tokens"
    )
    
    # Cost Metrics
    total_cost = fields.Monetary(
        string='Total Cost',
        currency_field='currency_id',
        default=0.0,
        help="Total estimated cost for this model on this date"
    )
    currency_id = fields.Many2one(
        'res.currency',
        string='Currency',
        default=lambda self: self.env.company.currency_id,
        required=True
    )
    
    # Performance Metrics
    avg_response_time = fields.Float(
        string='Avg Response Time (ms)',
        digits=(8, 2),
        help="Average response time in milliseconds"
    )
    min_response_time = fields.Integer(
        string='Min Response Time (ms)',
        help="Fastest response time recorded"
    )
    max_response_time = fields.Integer(
        string='Max Response Time (ms)',
        help="Slowest response time recorded"
    )
    
    # Success Rate
    success_rate = fields.Float(
        string='Success Rate (%)',
        compute='_compute_success_rate',
        store=True,
        digits=(5, 2),
        help="Percentage of successful requests"
    )
    
    # Operation Type Breakdown (JSON field for detailed breakdown)
    operation_breakdown = fields.Text(
        string='Operation Breakdown',
        help="JSON breakdown of requests by operation type"
    )
    
    # Company Information
    company_id = fields.Many2one(
        'res.company',
        string='Company',
        default=lambda self: self.env.company,
        required=True
    )
    
    # Computed Fields
    display_name = fields.Char(
        string='Display Name',
        compute='_compute_display_name',
        store=True
    )
    
    avg_cost_per_request = fields.Monetary(
        string='Avg Cost per Request',
        compute='_compute_average_costs',
        currency_field='currency_id',
        help="Average cost per API request"
    )
    
    avg_cost_per_token = fields.Float(
        string='Avg Cost per Token',
        compute='_compute_average_costs',
        digits=(12, 8),
        help="Average cost per token"
    )
    
    # SQL Constraints
    _sql_constraints = [
        ('unique_date_model_company', 
         'unique(date, model_name, company_id)', 
         'Only one statistics record per date/model/company combination is allowed.')
    ]
    
    @api.depends('total_prompt_tokens', 'total_completion_tokens')
    def _compute_total_tokens(self):
        """Calculate total tokens from input and output"""
        for record in self:
            record.total_tokens = record.total_prompt_tokens + record.total_completion_tokens
    
    @api.depends('total_requests', 'successful_requests')
    def _compute_success_rate(self):
        """Calculate success rate percentage"""
        for record in self:
            if record.total_requests > 0:
                record.success_rate = (record.successful_requests / record.total_requests) * 100
            else:
                record.success_rate = 0.0
    
    @api.depends('model_name', 'date')
    def _compute_display_name(self):
        """Generate display name"""
        for record in self:
            if record.date and record.model_name:
                record.display_name = f"{record.model_name} - {record.date.strftime('%Y-%m-%d')}"
            else:
                record.display_name = f"{record.model_name or 'Unknown'} - {record.date or 'No Date'}"
    
    @api.depends('total_cost', 'total_requests', 'total_tokens')
    def _compute_average_costs(self):
        """Calculate average costs per request and per token"""
        for record in self:
            if record.total_requests > 0:
                record.avg_cost_per_request = record.total_cost / record.total_requests
            else:
                record.avg_cost_per_request = 0.0
                
            if record.total_tokens > 0:
                record.avg_cost_per_token = record.total_cost / record.total_tokens
            else:
                record.avg_cost_per_token = 0.0
    
    @api.model
    def update_daily_statistics(self, target_date=None):
        """
        Update daily statistics by aggregating data from request logs
        
        Args:
            target_date (date): Date to update statistics for (defaults to today)
            
        Returns:
            list: List of updated/created statistics records
        """
        if target_date is None:
            target_date = fields.Date.today()
        
        # Get request log data for the target date
        request_logs = self.env['sc.openai.request.log'].search([
            ('timestamp', '>=', target_date),
            ('timestamp', '<', target_date + timedelta(days=1)),
        ])
        
        if not request_logs:
            _logger.info(f"No request logs found for {target_date}")
            return []
        
        # Group by model and calculate statistics
        model_stats = {}
        for log in request_logs:
            model = log.model_used
            if model not in model_stats:
                model_stats[model] = {
                    'total_requests': 0,
                    'successful_requests': 0,
                    'failed_requests': 0,
                    'total_prompt_tokens': 0,
                    'total_completion_tokens': 0,
                    'total_cost': 0.0,
                    'response_times': [],
                    'operations': {},
                }
            
            stats = model_stats[model]
            stats['total_requests'] += 1
            
            if log.status == 'success':
                stats['successful_requests'] += 1
            else:
                stats['failed_requests'] += 1
            
            stats['total_prompt_tokens'] += log.prompt_tokens or 0
            stats['total_completion_tokens'] += log.completion_tokens or 0
            stats['total_cost'] += log.estimated_cost or 0.0
            
            if log.response_time_ms:
                stats['response_times'].append(log.response_time_ms)
            
            # Track operation breakdown
            op_type = log.operation_type or 'unknown'
            if op_type not in stats['operations']:
                stats['operations'][op_type] = 0
            stats['operations'][op_type] += 1
        
        # Create or update statistics records
        updated_records = []
        for model, data in model_stats.items():
            # Calculate performance metrics
            if data['response_times']:
                avg_response_time = sum(data['response_times']) / len(data['response_times'])
                min_response_time = min(data['response_times'])
                max_response_time = max(data['response_times'])
            else:
                avg_response_time = 0.0
                min_response_time = 0
                max_response_time = 0
            
            # Find existing record or create new one
            existing = self.search([
                ('date', '=', target_date),
                ('model_name', '=', model),
                ('company_id', '=', self.env.company.id),
            ])
            
            values = {
                'total_requests': data['total_requests'],
                'successful_requests': data['successful_requests'],
                'failed_requests': data['failed_requests'],
                'total_prompt_tokens': data['total_prompt_tokens'],
                'total_completion_tokens': data['total_completion_tokens'],
                'total_cost': data['total_cost'],
                'avg_response_time': avg_response_time,
                'min_response_time': min_response_time,
                'max_response_time': max_response_time,
                'operation_breakdown': str(data['operations']),  # Store as JSON string
            }
            
            if existing:
                existing.write(values)
                updated_records.append(existing)
                _logger.info(f"Updated statistics for {model} on {target_date}")
            else:
                values.update({
                    'date': target_date,
                    'model_name': model,
                })
                new_record = self.create(values)
                updated_records.append(new_record)
                _logger.info(f"Created statistics for {model} on {target_date}")
        
        return updated_records
    
    @api.model
    def get_trend_analysis(self, model_name=None, days=30):
        """
        Get trend analysis for the specified period
        
        Args:
            model_name (str): Specific model to analyze (optional)
            days (int): Number of days to analyze
            
        Returns:
            dict: Trend analysis data
        """
        end_date = fields.Date.today()
        start_date = end_date - timedelta(days=days-1)
        
        domain = [
            ('date', '>=', start_date),
            ('date', '<=', end_date),
        ]
        
        if model_name:
            domain.append(('model_name', '=', model_name))
        
        records = self.search(domain)
        
        if not records:
            return {
                'success': False,
                'message': 'No data available for the specified period'
            }
        
        # Calculate trends
        total_requests = sum(r.total_requests for r in records)
        total_cost = sum(r.total_cost for r in records)
        total_tokens = sum(r.total_tokens for r in records)
        
        # Calculate daily averages
        days_with_data = len(set(r.date for r in records))
        avg_daily_requests = total_requests / days_with_data if days_with_data > 0 else 0
        avg_daily_cost = total_cost / days_with_data if days_with_data > 0 else 0
        avg_daily_tokens = total_tokens / days_with_data if days_with_data > 0 else 0
        
        # Model breakdown
        model_breakdown = {}
        for record in records:
            model = record.model_name
            if model not in model_breakdown:
                model_breakdown[model] = {
                    'requests': 0,
                    'cost': 0.0,
                    'tokens': 0,
                }
            model_breakdown[model]['requests'] += record.total_requests
            model_breakdown[model]['cost'] += record.total_cost
            model_breakdown[model]['tokens'] += record.total_tokens
        
        return {
            'success': True,
            'period': {
                'start_date': start_date,
                'end_date': end_date,
                'days': days,
                'days_with_data': days_with_data,
            },
            'totals': {
                'requests': total_requests,
                'cost': total_cost,
                'tokens': total_tokens,
            },
            'daily_averages': {
                'requests': avg_daily_requests,
                'cost': avg_daily_cost,
                'tokens': avg_daily_tokens,
            },
            'model_breakdown': model_breakdown,
        }
    
    def action_view_request_logs(self):
        """View individual request logs for this model/date combination"""
        self.ensure_one()
        
        return {
            'type': 'ir.actions.act_window',
            'name': f"Request Logs - {self.display_name}",
            'res_model': 'sc.openai.request.log',
            'view_mode': 'list,form',
            'target': 'current',
            'domain': [
                ('timestamp', '>=', self.date),
                ('timestamp', '<', self.date + timedelta(days=1)),
                ('model_used', '=', self.model_name),
            ],
            'context': {
                'default_model_used': self.model_name,
                'search_default_group_by_operation': 1,
            }
        }
    
    @api.model
    def generate_missing_statistics(self, days_back=7):
        """
        Generate statistics for days that might be missing
        
        Args:
            days_back (int): Number of days back to check and generate
        """
        generated_count = 0
        
        for i in range(days_back):
            target_date = fields.Date.today() - timedelta(days=i)
            
            # Check if we have request logs for this date
            has_logs = self.env['sc.openai.request.log'].search_count([
                ('timestamp', '>=', target_date),
                ('timestamp', '<', target_date + timedelta(days=1)),
            ])
            
            if has_logs:
                # Check if we already have statistics for this date
                existing_stats = self.search_count([('date', '=', target_date)])
                
                if not existing_stats:
                    # Generate statistics for this date
                    self.update_daily_statistics(target_date)
                    generated_count += 1
        
        if generated_count > 0:
            _logger.info(f"Generated statistics for {generated_count} missing days")
        
        return generated_count
    
    def action_view_request_logs(self):
        """Open request logs for this model and date"""
        self.ensure_one()
        
        domain = [
            ('model_used', '=', self.model_name),
            ('timestamp', '>=', self.date),
            ('timestamp', '<', self.date + timedelta(days=1)),
        ]
        
        return {
            'type': 'ir.actions.act_window',
            'name': _('Request Logs - %s (%s)') % (self.model_name, self.date),
            'res_model': 'sc.openai.request.log',
            'view_mode': 'list,form',
            'target': 'current',
            'domain': domain,
            'context': {
                'search_default_group_by_status': 1,
            }
        }