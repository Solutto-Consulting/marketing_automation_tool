<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron Job: Process Translation Tasks -->
    <record id="ir_cron_process_translation_tasks" model="ir.cron">
        <field name="name">SC Marketing: Process Translation Tasks</field>
        <field name="model_id" ref="model_sc_translation_task"/>
        <field name="state">code</field>
        <field name="code">model.process_pending_translations()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="priority">5</field>
        <field name="user_id" ref="base.user_admin"/>
    </record>
    
    <!-- Cron Job: Cleanup Old Translation Tasks -->
    <record id="ir_cron_cleanup_translation_tasks" model="ir.cron">
        <field name="name">SC Marketing: Cleanup Old Translation Tasks</field>
        <field name="model_id" ref="model_sc_translation_task"/>
        <field name="state">code</field>
        <field name="code">model.cleanup_old_tasks()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="priority">10</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="nextcall" eval="(DateTime.now() + timedelta(hours=2))"/>
    </record>
    
    <!-- Cron Job: Monitor Translation Health -->
    <record id="ir_cron_monitor_translation_health" model="ir.cron">
        <field name="name">SC Marketing: Monitor Translation Health</field>
        <field name="model_id" ref="model_sc_translation_task"/>
        <field name="state">code</field>
        <field name="code">model.monitor_translation_health()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
        <field name="priority">7</field>
        <field name="user_id" ref="base.user_admin"/>
    </record>
</odoo>
