<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job to process pending content idea tasks -->
        <record id="cron_process_content_idea_tasks" model="ir.cron">
            <field name="name">Process Content Idea Tasks</field>
            <field name="model_id" ref="model_sc_content_idea_task"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_pending_tasks()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(minutes=15)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
            <field name="priority">5</field>
        </record>

        <!-- Cron job to process pending content generation tasks -->
        <record id="cron_process_content_generation_tasks" model="ir.cron">
            <field name="name">Process Content Generation Tasks</field>
            <field name="model_id" ref="model_sc_content_generation_task"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_pending_tasks()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(minutes=10)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
            <field name="priority">5</field>
        </record>

        <!-- Cron job to process AI translation tasks -->
        <record id="cron_process_translation_tasks" model="ir.cron">
            <field name="name">Process AI Translation Tasks</field>
            <field name="model_id" ref="model_sc_translation_task"/>
            <field name="state">code</field>
            <field name="code">model.cron_process_translation_tasks()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
            <field name="priority">5</field>
        </record>
    </data>
</odoo>
