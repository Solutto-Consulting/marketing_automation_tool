<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Blog Post Translation Wizard Form View -->
    <record id="blog_post_translation_wizard_view_form" model="ir.ui.view">
        <field name="name">blog.post.translation.wizard.form</field>
        <field name="model">blog.post.translation.wizard</field>
        <field name="arch" type="xml">
            <form string="Send to Translate">
                <div class="alert alert-info" role="alert">
                    <strong>Translation Service</strong><br/>
                    This will send the selected blog posts to the external translation service.
                    You will be notified when the translation is complete.
                </div>
                
                <group>
                    <group>
                        <field name="post_count" string="Posts Selected" readonly="1"/>
                        <field name="target_lang" required="1" 
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </group>
                
                <group string="Selected Blog Posts">
                    <field name="post_ids" nolabel="1" readonly="1">
                        <list string="Blog Posts" create="false" edit="false" delete="false">
                            <field name="name"/>
                            <field name="author_name"/>
                            <field name="translation_status" widget="badge" 
                                   decoration-info="translation_status == 'not_translated'"
                                   decoration-warning="translation_status == 'in_progress'"
                                   decoration-success="translation_status == 'completed'"
                                   decoration-danger="translation_status == 'failed'"/>
                        </list>
                    </field>
                </group>
                
                <footer>
                    <button name="action_send_to_translate" 
                            string="Send to Translate" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Blog Post Translation Wizard Action -->
    <record id="action_blog_post_translation_wizard" model="ir.actions.act_window">
        <field name="name">Send to Translate</field>
        <field name="res_model">blog.post.translation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
