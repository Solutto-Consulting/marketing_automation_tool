<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Blog Post Translation Wizard Form View -->
    <record id="sc_translate_blog_post_wizard_view_form" model="ir.ui.view">
        <field name="name">sc.translate.blog.post.wizard.view.form</field>
        <field name="model">sc.translate.blog.post.wizard</field>
        <field name="arch" type="xml">
            <form string="Translate Blog Posts with AI">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span>AI-Powered Blog Translation</span>
                        </h1>
                        <p class="oe_grey">
                            Translate selected blog posts using OpenAI's advanced language models.
                        </p>
                    </div>
                    
                    <group>
                        <group>
                            <field name="target_lang_id" 
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="blog_post_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="AI Instructions" name="instructions">
                            <field name="system_instructions" 
                                   placeholder="Optional: Provide specific instructions for the AI translator about tone, style, or special considerations..."
                                   nolabel="1"/>
                            <div class="alert alert-info mt16" role="alert">
                                <p><strong>Tips for better translations:</strong></p>
                                <ul>
                                    <li>Specify the desired tone (e.g., "formal", "casual", "professional")</li>
                                    <li>Mention target audience (e.g., "technical audience", "general readers")</li>
                                    <li>Include industry-specific instructions if needed</li>
                                    <li>Leave empty for standard professional translation</li>
                                </ul>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                
                <footer>
                    <button string="Translate" name="action_translate" type="object" class="btn-primary"/>
                    <button string="Cancel" name="action_cancel" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="sc_translate_blog_post_wizard_action" model="ir.actions.act_window">
        <field name="name">Translate with AI</field>
        <field name="res_model">sc.translate.blog.post.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
