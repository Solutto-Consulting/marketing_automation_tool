<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Translation Diagnosis Wizard Form View -->
        <record id="sc_translation_diagnosis_wizard_view_form" model="ir.ui.view">
            <field name="name">sc.translation.diagnosis.wizard.form</field>
            <field name="model">sc.translation.diagnosis.wizard</field>
            <field name="arch" type="xml">
                <form string="Translation Diagnosis">
                    <sheet>
                        <group>
                            <field name="task_id" readonly="1"/>
                            <field name="blog_post_id" readonly="1"/>
                        </group>
                        <group string="Diagnosis Results">
                            <field name="diagnosis_text" nolabel="1" widget="text"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_retranslate" type="object" string="Fix Translation" class="btn-primary" 
                                invisible="not task_id"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
